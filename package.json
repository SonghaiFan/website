{
  "name": "website",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:home": "npm run dev --workspace @songhai/home",
    "dev:blog": "npm run dev --workspace @songhai/blog",
    "stage": "node scripts/blog.mjs stage",
    "build": "npm run build:home && npm run build:blog",
    "build:home": "node scripts/build-home.mjs",
    "build:blog": "node scripts/blog.mjs build",
    "test": "node --test scripts/*.test.mjs apps/api/test/*.test.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "dev:resume": "npm run dev --workspace @songhai/resume",
    "build:resume": "npm run build --workspace @songhai/resume",
    "check": "npm test && npm run build:resume && npm run build",
    "status": "node scripts/status.mjs",
    "cv:export": "node scripts/export-resume.mjs",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.jsonc --keep-vars"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "wrangler": "4.135.0",
    "playwright": "1.56.1"
  }
}
